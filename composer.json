{
    "name": "rias/statamic-button-box",
    "type": "statamic-addon",
    "autoload": {
        "psr-4": {
            "Rias\\ButtonBox\\": "src"
        }
    },
    "require":  {
        "statamic/cms": "^6.0"
    },
    "extra": {
        "statamic": {
            "name": "Button Box",
            "description": "Button Box addon"
        },
        "laravel": {
            "providers": [
                "Rias\\ButtonBox\\ServiceProvider"
            ]
        }
    },
   "minimum-stability": "dev",
   "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    }
}
